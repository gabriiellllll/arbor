#!/bin/sh
# Rejects commit messages that are not Conventional Commits or that contain
# attribution trailers/mentions. Used as a git hook and by CI (commit-check job).
# Usage: commit-msg <file-containing-message>

msg_file="$1"
[ -f "$msg_file" ] || { echo "commit-msg: message file not found: $msg_file" >&2; exit 2; }

# Ignore comment lines git adds to the editor template.
msg=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$msg" | sed -n '1p')

# Let git's own merge/revert/fixup subjects through.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(canvas): add zoom'." >&2
  echo "  got: $subject" >&2
  exit 1
fi

if printf '%s\n' "$msg" | grep -Eiq 'claude|anthropic|co-authored-by|generated with|(^|[^[:alnum:]_])ai([^[:alnum:]_]|$)'; then
  echo "commit-msg: message must not contain attribution or assistant mentions." >&2
  exit 1
fi

exit 0
